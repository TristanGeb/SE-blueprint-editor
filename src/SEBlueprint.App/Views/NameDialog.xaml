<Window x:Class="SEBlueprint.App.Views.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save as new blueprint"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="14" Width="360">
        <TextBlock x:Name="PromptText" Text="Name for the new blueprint:" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" TextChanged="OnTextChanged" />
        <TextBlock x:Name="ErrorText" Foreground="#C03030" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Save" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
