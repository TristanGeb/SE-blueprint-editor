<Window x:Class="SEBlueprint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:vm="clr-namespace:SEBlueprint.App.ViewModels"
        xmlns:conv="clr-namespace:SEBlueprint.App.Converters"
        xmlns:models="clr-namespace:SEBlueprint.Core.Models;assembly=SEBlueprint.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenBlueprintCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsNewCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
        <KeyBinding Key="P" Command="{Binding PaintSelectedCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,6,6,4" />
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open blueprint…" InputGestureText="Ctrl+O" Command="{Binding OpenBlueprintCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"
                          ToolTip="Overwrite this blueprint. The first save keeps the original as bp.sbc.bak." />
                <MenuItem Header="Save as _new blueprint…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsNewCommand}"
                          ToolTip="Save a copy under a new name and leave the original untouched." />
                <Separator />
                <MenuItem Header="Show blueprint in _Explorer" Command="{Binding OpenBlueprintFolderCommand}" />
                <MenuItem Header="Set _game folder…" Command="{Binding ChooseGameFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="{Binding RedoHeader}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="_Paint selected" InputGestureText="P" Command="{Binding PaintSelectedCommand}" />
                <MenuItem Header="_Delete selected" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}" />
                <Separator />
                <MenuItem Header="Clear _selection" InputGestureText="Esc" Command="{Binding ClearSelectionCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Zoom to fit" InputGestureText="F" Click="OnZoomExtents" />
                <Separator />
                <MenuItem Header="Show _textures" Command="{Binding ToggleTexturesCommand}"
                          IsChecked="{Binding ShowTextures, Mode=OneWay}" />
                <MenuItem Header="Model _detail">
                    <MenuItem Header="_Boxes only (fastest)"
                              Command="{Binding SetModelDetailCommand}" CommandParameter="{x:Static models:ModelDetail.Boxes}"
                              IsChecked="{Binding ModelDetail, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Boxes}" />
                    <MenuItem Header="_Low"
                              Command="{Binding SetModelDetailCommand}" CommandParameter="{x:Static models:ModelDetail.Low}"
                              IsChecked="{Binding ModelDetail, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Low}" />
                    <MenuItem Header="_Medium (recommended)"
                              Command="{Binding SetModelDetailCommand}" CommandParameter="{x:Static models:ModelDetail.Medium}"
                              IsChecked="{Binding ModelDetail, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Medium}" />
                    <MenuItem Header="_High"
                              Command="{Binding SetModelDetailCommand}" CommandParameter="{x:Static models:ModelDetail.High}"
                              IsChecked="{Binding ModelDetail, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=High}" />
                    <MenuItem Header="_Full (slow on big ships)"
                              Command="{Binding SetModelDetailCommand}" CommandParameter="{x:Static models:ModelDetail.Full}"
                              IsChecked="{Binding ModelDetail, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Full}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: blueprint tree, properties, paint -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="220" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TreeView x:Name="BlueprintTree"
                          Grid.Row="0"
                          ItemsSource="{Binding TreeRoots}"
                          SelectedItemChanged="OnTreeSelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ToolTip="Select a grid or block type to select all of its blocks">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <EventSetter Event="Selected" Handler="OnTreeItemSelected" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Header}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

                <!-- Properties -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Properties" Style="{StaticResource SectionHeader}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedProperties}" Margin="6,0,6,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="Gray" />
                                        <Border Grid.Column="1" Width="14" Height="14" Margin="0,0,6,0"
                                                Background="{Binding Swatch}" BorderBrush="Gray" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Paint -->
                <StackPanel Grid.Row="3" DataContext="{Binding Paint}">
                    <Separator />
                    <TextBlock Text="Paint" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="6,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.RowSpan="3" Width="54" Height="54" Margin="0,0,10,0"
                                Background="{Binding PreviewBrush}" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" />

                        <TextBlock Grid.Column="1" Text="H" Style="{StaticResource SliderLabel}" />
                        <Slider Grid.Column="2" Minimum="0" Maximum="360" Value="{Binding Hue}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.167" />
                                    <GradientStop Color="#00FF00" Offset="0.333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.667" />
                                    <GradientStop Color="#FF00FF" Offset="0.833" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBlock Grid.Column="3" Text="{Binding Hue, StringFormat={}{0:0}}" Style="{StaticResource SliderValue}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Text="S" Style="{StaticResource SliderLabel}" />
                        <Slider Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Saturation}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Saturation, StringFormat={}{0:0}}" Style="{StaticResource SliderValue}" />

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="V" Style="{StaticResource SliderLabel}" />
                        <Slider Grid.Row="2" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Value}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Value, StringFormat={}{0:0}}" Style="{StaticResource SliderValue}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,6,6,8">
                        <Button Content="Pick from selection" Padding="8,3" Margin="0,0,6,0"
                                Command="{Binding DataContext.PickColorFromSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Set the sliders to the first selected block's color" />
                        <Button Content="Paint selected (P)" Padding="8,3"
                                Command="{Binding DataContext.PaintSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

            <!-- 3D viewport -->
            <hx:Viewport3DX x:Name="Viewport"
                            Grid.Column="2"
                            BackgroundColor="#4A515C"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            FXAALevel="Low"
                            EnableSwapChainRendering="False"
                            IsZoomEnabled="True"
                            ZoomAroundMouseDownPoint="True"
                            MouseDown3D="OnViewportMouseDown3D">
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera Position="30,30,30" LookDirection="-30,-30,-30" UpDirection="0,1,0"
                                          NearPlaneDistance="0.1" FarPlaneDistance="100000" />
                </hx:Viewport3DX.Camera>
                <hx:AmbientLight3D Color="#505560" />
                <!-- Key light follows the camera so whatever you look at is lit. -->
                <hx:DirectionalLight3D Color="#D0D0D0"
                                       Direction="{Binding Camera.LookDirection, ElementName=Viewport}" />
                <!-- Fixed light from above, so faces turned away from the camera aren't flat black. -->
                <hx:DirectionalLight3D Color="#9098A0" Direction="-0.3,-1,-0.4" />
                <hx:GroupModel3D x:Name="SceneHost" />
            </hx:Viewport3DX>

            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#D0D8E0" FontSize="16" TextAlignment="Center" IsHitTestVisible="False"
                       Text="File → Open blueprint… (Ctrl+O)&#10;or drop a blueprint folder here">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Blueprint}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
