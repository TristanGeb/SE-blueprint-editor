<Window x:Class="SEBlueprint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:vm="clr-namespace:SEBlueprint.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="800" Width="1300"
        AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenBlueprintCommand}" />
    </Window.InputBindings>

    <DockPanel x:Name="Root">
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open blueprint…" InputGestureText="Ctrl+O" Command="{Binding OpenBlueprintCommand}" />
                <MenuItem Header="Show blueprint in _Explorer" Command="{Binding OpenBlueprintFolderCommand}" />
                <Separator />
                <MenuItem Header="Set _game folder…" Command="{Binding ChooseGameFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Zoom to fit" InputGestureText="F" Click="OnZoomExtents" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: blueprint tree + properties -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="240" MinHeight="80" />
                </Grid.RowDefinitions>

                <TreeView x:Name="BlueprintTree"
                          Grid.Row="0"
                          ItemsSource="{Binding TreeRoots}"
                          SelectedItemChanged="OnTreeSelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <EventSetter Event="Selected" Handler="OnTreeItemSelected" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Header}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="SemiBold" Margin="6,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedProperties}" Margin="6,0,6,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="Gray" />
                                        <Border Grid.Column="1" Width="14" Height="14" Margin="0,0,6,0"
                                                Background="{Binding Swatch}" BorderBrush="Gray" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

            <!-- 3D viewport -->
            <hx:Viewport3DX x:Name="Viewport"
                            Grid.Column="2"
                            BackgroundColor="#1E2228"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            FXAALevel="Low"
                            EnableSwapChainRendering="True"
                            MouseDown3D="OnViewportMouseDown3D">
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera Position="30,30,30" LookDirection="-30,-30,-30" UpDirection="0,1,0"
                                          NearPlaneDistance="0.1" FarPlaneDistance="100000" />
                </hx:Viewport3DX.Camera>
                <hx:AmbientLight3D Color="#505560" />
                <hx:DirectionalLight3D Color="#E0E0E0"
                                       Direction="{Binding Camera.LookDirection, ElementName=Viewport}" />
                <hx:GroupModel3D x:Name="SceneHost" />
            </hx:Viewport3DX>

            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#8090A0" FontSize="16" TextAlignment="Center" IsHitTestVisible="False"
                       Text="File → Open blueprint… (Ctrl+O)&#10;or drop a blueprint folder here">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Blueprint}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
